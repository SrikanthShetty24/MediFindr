# MediFindr — Apache Configuration
# Compatible with WAMP / XAMPP / mod_fcgid on Windows

Options -Indexes

# Security headers (only if mod_headers is loaded)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Protect sensitive files
<IfModule mod_authz_core.c>
    # Apache 2.4+
    <FilesMatch "\.(sql|log|md|json|lock)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    # Apache 2.2 fallback
    <FilesMatch "\.(sql|log|md|json|lock)$">
        Order allow,deny
        Require all granted
    </FilesMatch>
</IfModule>

# Default index
DirectoryIndex index.php index.html
